SUPABASE_URL=
SUPABASE_SERVICE_KEY=
JWT_SECRET=
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_INDIVIDUAL=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_CLASSROOM=
EBOOK_PDF_URL=https://your-storage-url/three-baby-birdies.pdf
ALLOWED_ORIGINS=https://threebabybirdies.com,http://localhost:5173
DEFAULT_CLIENT_DOMAIN=threebabybirdies.com

# ---- Text to speech -------------------------------------------------
# THE ONLY THING STILL NEEDED IS THE KEY. Paste it below and restart.
#
# Issue a NEW one. The key hardcoded in the Flutter app
# (elevenlabs_service.dart) has shipped inside an installable binary, so
# treat it as compromised and revoke it rather than reusing it.
#
# Leaving this blank is a valid state, not an outage: /tts answers 503 on
# purpose and the site falls back to the browser's own speechSynthesis,
# which costs nothing and sends nothing anywhere. It just sounds worse,
# and the beak cannot follow the words without an audio stream to measure.
ELEVENLABS_API_KEY=

# The voices are already set in code (EMMA for Chirpy, Jessa for Mama
# Bird) and only need setting here to override them.
#   ELEVENLABS_VOICE_CHIRPY=pPdl9cQBQq4p6mRkZy2Z
#   ELEVENLABS_VOICE_MAMA=yj30vwTGJxSHezdAGsv9
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Where contact form enquiries are emailed. Falls back to SMTP_FROM.
# With SMTP unset the enquiry is still stored, just not emailed.
CONTACT_TO=
