# Text to speech. Unset is a valid state: /tts answers 503 and the site
# falls back to the browser's own speechSynthesis, which costs nothing.
# Issue a NEW key here; the one hardcoded in the Flutter app
# (elevenlabs_service.dart) should be treated as compromised and revoked.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_CHIRPY=
ELEVENLABS_VOICE_MAMA=
ELEVENLABS_MODEL=eleven_turbo_v2_5
