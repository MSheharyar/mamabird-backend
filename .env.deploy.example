# Copy to .env.deploy (never committed) and fill in. See docs/DEPLOY.md.
# Run "node scripts/deploy.mjs check" after the first four lines: it shows the values for the rest.
SSH_HOST=
SSH_USER=root
SSH_PORT=22
# The private key file on this PC; its .pub half is added on the VPS. Windows example:
SSH_KEY=C:\Users\Dell\.ssh\threebabybirdies_deploy

# The folder on the VPS that holds app/, requirements.txt and the server's .env (the contents of backend/).
APP_DIR=
# The Python environment the API runs in (default: APP_DIR/venv).
VENV=

# How the API is run. Usually a systemd service: give its name and the script restarts it and reads its log.
SERVICE=
# Or give the commands yourself (e.g. pm2):  RESTART_CMD=pm2 restart mamabird-api   LOGS_CMD=pm2 logs mamabird-api --nostream --lines
RESTART_CMD=
LOGS_CMD=

API_URL=https://api.threebabybirdies.com

# Optional: extra comma-separated names in APP_DIR that are not code and must never be replaced (uploads, data).
KEEP=
